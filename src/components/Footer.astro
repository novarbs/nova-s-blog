---

import { profileConfig, siteConfig } from "../config";

const currentYear = new Date().getFullYear();
---

<div class="transition flex items-center justify-between gap-4 border-t-[1.5px] border-[var(--card-border)] mt-8 mb-10 pt-5 px-6 md:px-2">
    <div class="transition text-50 text-xs">
        &copy; {currentYear} {profileConfig.name} — {siteConfig.title}
    </div>
    <div class="transition text-50 text-xs">
        <a class="transition hover:text-[var(--primary)]" target="_blank" href="https://astro.build">Astro</a> で構築
    </div>
</div>
