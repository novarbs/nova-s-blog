---
// 型定義とユーティリティ関数をインポート
import type { CollectionEntry } from "astro:content";
import { getPostUrlBySlug } from "@utils/url-utils";
import PostCard from "./PostCard.astro";

// propsからpageオブジェクトを取得
const { page } = Astro.props;

// アニメーション設定
const ANIMATION_DELAY_START = 0; // 初期遅延
const ANIMATION_DELAY_INTERVAL = 50; // 各カードの遅延間隔

// ジェネリクス構文の修正：JSXと誤認されないようスペースを追加
type PostEntry = CollectionEntry<"posts">;
---
<!-- 記事リストコンテナ -->
<div class="transition flex flex-col gap-3 md:gap-4 mb-4">
  {
    // 記事データをループ
    page.data.map((entry: PostEntry, index: number) => {
      // 現在のカードのアニメーション遅延を計算
      const delay = ANIMATION_DELAY_START + index * ANIMATION_DELAY_INTERVAL;
      
      return (
        // 記事カードコンポーネントをレンダリング
        <PostCard
          key={entry.slug}  // ユニークなkey値でパフォーマンス向上
          entry={entry}
          title={entry.data.title}
          tags={entry.data.tags}
          category={entry.data.category}
          published={entry.data.published}
          updated={entry.data.updated}
          url={getPostUrlBySlug(entry.slug)}
          image={entry.data.image}
          description={entry.data.description}
          draft={entry.data.draft}
          pinned={entry.data.pinned}
          class:list="onload-animation"
          style={`animation-delay: calc(var(--content-delay) + ${delay}ms);`}
        />
      );
    })
  }
</div>
