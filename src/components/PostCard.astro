---
// 必要なモジュールとコンポーネントをインポート
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { getCategoryUrl, getDir, getTagUrl } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";

// コンポーネントプロパティのインターフェース定義
interface Props {
  class?: string;
  entry: CollectionEntry<"posts">;
  title: string;
  url: string;
  published: Date;
  updated?: Date;
  tags: string[];
  category: string | null;
  image: string;
  description: string;
  draft: boolean;
  style: string;
  pinned?: boolean;
}

// コンポーネントプロパティを分割代入
const {
  entry,
  title,
  url: postUrl,
  published,
  tags,
  category,
  image,
  description,
  style,
  pinned,
} = Astro.props;
const className = Astro.props.class;

// カバー画像の有無を確認
const hasCover = image !== undefined && image !== null && image !== "";

// シリーズ名（あれば）
const series = entry.data.series;

// 日付を「MM.DD」と「YYYY」に分けて表示する
const pad = (n: number) => String(n).padStart(2, "0");
const monthDay = `${pad(published.getMonth() + 1)}.${pad(published.getDate())}`;
const year = String(published.getFullYear());

// カテゴリの有無を事前計算
const hasCategory = category && category.trim() !== "";
---

<!-- 記事カードコンテナ -->
<div
  class:list={[
    "card-base flex w-full overflow-hidden relative p-6 md:p-7 gap-5 md:gap-6 items-start",
    className,
  ]}
  style={style}
>
  {pinned && <div class="absolute top-3 right-3 text-[var(--primary)]">
      <Icon name="mdi:pin" class="w-5 h-5" />
  </div>}

  <!-- 日付カラム -->
  <div class="w-[4.5rem] md:w-[5.5rem] flex-shrink-0 flex flex-col items-center gap-0.5 pt-1">
    <div class="text-[1.5rem] md:text-[1.75rem] font-extrabold leading-none text-[var(--primary)] transition">
      {monthDay}
    </div>
    <div class="text-xs font-medium text-50 transition">
      {year}
    </div>
  </div>

  <!-- コンテンツ領域 -->
  <div class="flex flex-col gap-2 min-w-0 flex-1">
    <!-- カテゴリ・シリーズのチップ -->
    <div class="flex flex-wrap items-center gap-2">
      {hasCategory && (
        <a
          href={getCategoryUrl(category)}
          aria-label={`カテゴリ「${category}」の記事一覧`}
          class="transition rounded-full px-3 py-0.5 text-xs font-bold
                 bg-[var(--btn-regular-bg)] text-[var(--btn-content)]
                 hover:bg-[var(--btn-regular-bg-hover)] active:bg-[var(--btn-regular-bg-active)]"
        >
          {category}
        </a>
      )}
      {series && (
        <div class="transition rounded-full px-3 py-0.5 text-xs font-bold
                    bg-[oklch(0.95_0.06_95)] text-[oklch(0.48_0.1_95)]
                    dark:bg-[oklch(0.35_0.05_95)] dark:text-[oklch(0.85_0.08_95)]">
          シリーズ: {series}
        </div>
      )}
    </div>

    <!-- タイトル -->
    <a
      href={postUrl}
      class="transition group w-full block font-extrabold text-lg md:text-xl leading-relaxed text-90
        hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
        active:text-[var(--title-active)] dark:active:text-[var(--title-active)]"
    >
      {title}
      <Icon
        class="inline text-[1.5rem] text-[var(--primary)] md:hidden translate-y-0.5 absolute"
        name="material-symbols:chevron-right-rounded"
      ></Icon>
      <Icon
        class="text-[var(--primary)] text-[1.5rem] transition hidden md:inline absolute translate-y-0.5 opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0"
        name="material-symbols:chevron-right-rounded"
      ></Icon>
    </a>

    <!-- 記事の説明 -->
    <div class="transition text-sm leading-relaxed text-75 line-clamp-2">
      {description}
    </div>

    <!-- タグ -->
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-x-3.5 gap-y-1 mt-0.5">
        {tags.map((tag) => (
          <a
            href={getTagUrl(tag)}
            aria-label={`タグ「${tag.trim()}」の記事一覧`}
            class="transition text-xs text-50 hover:text-[var(--primary)]"
          >
            # {tag.trim()}
          </a>
        ))}
      </div>
    )}
  </div>

  <!-- カバー画像（ある場合のみ、右側にサムネイル表示） -->
  {hasCover && (
    <a
      href={postUrl}
      aria-label={title}
      class="group hidden md:block w-[8.5rem] h-[6rem] flex-shrink-0 relative rounded-xl overflow-hidden active:scale-95 transition"
    >
      <div class="absolute pointer-events-none z-10 w-full h-full group-hover:bg-black/30 group-active:bg-black/50 transition"></div>
      <ImageWrapper
        src={image}
        basePath={path.join("content/posts/", getDir(entry.id))}
        alt="Cover Image of the Post"
        class="w-full h-full"
      ></ImageWrapper>
    </a>
  )}
</div>
