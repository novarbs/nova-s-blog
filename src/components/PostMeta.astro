---
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getCategoryUrl, getTagUrl } from "../utils/url-utils";

// コンポーネントプロパティのインターフェース定義
interface Props {
	class: string; // 外部から渡されるCSSクラス名
	published: Date; // 記事の公開日（必須）
	updated?: Date; // 記事の最終更新日（任意）
	tags: string[]; // 記事のタグ配列
	category: string | null; // 記事のカテゴリ（nullの場合あり）
	hideTagsForMobile?: boolean; // モバイル端末でタグを非表示にするか
	hideUpdateDate?: boolean; // 更新日を非表示にするか
}

// Astro.propsからパラメータを分割代入
const {
	class: className, // JSのキーワードとの衝突を回避するためリネーム
	published,
	updated,
	tags,
	category,
	hideTagsForMobile = false, // デフォルトではモバイルでもタグを表示
	hideUpdateDate = false, // デフォルトでは更新日を表示
} = Astro.props;

// 更新日を表示するかどうかを事前計算
const shouldShowUpdated =
	!hideUpdateDate && // 更新日の非表示設定がない
	updated && // 更新日が存在する
	updated.getTime() !== published.getTime(); // 更新日と公開日が異なる

// タグの有無を事前計算
const hasTags = tags && tags.length > 0;

// カテゴリの有無を事前計算
const hasCategory = category && category.trim() !== "";
---

<!-- 
  ブログ記事メタデータコンテナ
  表示内容：公開日、更新日、カテゴリ、タグ
  レスポンシブ対応：モバイル端末でタグを非表示にする設定あり
-->
<div 
  class:list={[
    "flex flex-wrap text-neutral-500 dark:text-neutral-400",
    "items-center gap-4 gap-x-4 gap-y-2",
    className
  ]}
>
  <!-- 公開日 -->
  <div class="flex items-center">
    <div class="meta-icon">
      <!-- カレンダーアイコン -->
      <Icon name="material-symbols:calendar-today-outline-rounded" class="text-xl" />
    </div>
    <!-- フォーマット済みの日付 -->
    <span class="text-50 text-sm font-medium">
      {formatDateToYYYYMMDD(published)}
    </span>
  </div>

  <!-- 更新日（条件付きレンダリング） -->
  {shouldShowUpdated && (
    <div class="flex items-center">
      <div class="meta-icon">
        <!-- 編集アイコン -->
        <Icon name="material-symbols:edit-calendar-outline-rounded" class="text-xl" />
      </div>
      <!-- フォーマット済みの更新日 -->
      <span class="text-50 text-sm font-medium">
        {formatDateToYYYYMMDD(updated)}
      </span>
    </div>
  )}

  <!-- 記事カテゴリ（カテゴリがある場合のみ表示） -->
  {hasCategory && (
    <div class="flex items-center">
      <div class="meta-icon">
        <!-- 書籍アイコン -->
        <Icon name="material-symbols:book-2-outline-rounded" class="text-xl" />
      </div>
      <div class="flex flex-row flex-nowrap items-center">
        <!-- カテゴリリンク -->
        <a 
          href={getCategoryUrl(category)} 
          aria-label={`View all posts in the ${category} category`}
          class="link-lg transition text-50 text-sm font-medium
                 hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap"
        >
          {category}
        </a>
      </div>
    </div>
  )}

  <!-- 記事タグ（タグがある場合のみ表示） -->
  {hasTags && (
    <div 
      class:list={[
        "items-center",
        {
          "flex": !hideTagsForMobile, // PC端末および非表示でない場合に表示
          "hidden md:flex": hideTagsForMobile // モバイルでは非表示、中画面以上で表示
        }
      ]}
    >
      <div class="meta-icon">
        <!-- タグアイコン -->
        <Icon name="material-symbols:tag-rounded" class="text-xl" />
      </div>
      <div class="flex flex-row flex-nowrap items-center">
        <!-- タグリストをレンダリング -->
        {tags.map((tag, index) => (
          <>
            {/* タグ間にセパレーターを追加（最初のタグの前には追加しない） */}
            {index > 0 && (
              <div class="mx-1.5 text-[var(--meta-divider)] text-sm">/</div>
            )}
            {/* 個別のタグリンク */}
            <a
              href={getTagUrl(tag)}
              aria-label={`View all posts with the ${tag.trim()} tag`}
              class="link-lg transition text-50 text-sm font-medium
                     hover:text-[var(--primary)] dark:hover:text-[var(--primary)] whitespace-nowrap"
            >
              {tag.trim()}
            </a>
          </>
        ))}
      </div>
    </div>
  )}
</div>